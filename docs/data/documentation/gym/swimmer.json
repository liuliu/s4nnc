tion\/Gym\/Swimmer","url":"\/documentation\/gym\/swimmer"},"doc://org.liuliu.s4nnc/documentation/Gym/MuJoCoEnv":{"url":"\/documentation\/gym\/mujocoenv","abstract":[],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MuJoCoEnv","kind":"identifier"}],"navigatorTitle":[{"text":"MuJoCoEnv","kind":"identifier"}],"kind":"symbol","title":"MuJoCoEnv","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/Gym\/MuJoCoEnv","type":"topic","role":"symbol"},"doc://org.liuliu.s4nnc/documentation/Gym/Swimmer/model":{"type":"topic","kind":"symbol","url":"\/documentation\/gym\/swimmer\/model","role":"symbol","title":"model","abstract":[],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"model"},{"text":": ","kind":"text"},{"text":"MjModel","preciseIdentifier":"s:6MuJoCo7MjModelV","kind":"typeIdentifier"}],"identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/Gym\/Swimmer\/model"}}}