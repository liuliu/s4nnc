{"hierarchy":{"paths":[["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"]]},"variants":[{"paths":["\/documentation\/nnc\/modelbuilder"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModelBuilder"],"kind":"relationships"},{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModel"],"kind":"relationships"}],"abstract":[{"text":"A model builder is a more generic type of model. A model can be quite static,","type":"text"},{"text":" ","type":"text"},{"text":"thus, you have to be quite careful to have a model work with dynamic inputs.","type":"text"},{"text":" ","type":"text"},{"text":"You cannot use reshape, or anything that can generate fixed tensor outputs from","type":"text"},{"text":" ","type":"text"},{"text":"a fixed inputs.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ModelBuilder"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"text":"A model builder on the other hand doesn’t have that restriction. When input changes,","type":"text"},{"text":" ","type":"text"},{"text":"it simply calls the given builder closure to construct a new model. In such way,","type":"text"},{"text":" ","type":"text"},{"text":"you can continue to use reshape etc to assume fixed inputs and outputs, it will just","type":"text"},{"text":" ","type":"text"},{"text":"work for dynamic inputs. The newly built model will carry over stateful components","type":"text"},{"text":" ","type":"text"},{"text":"(parameters) from the old models, thus, it doesn’t reset your training. This also means","type":"text"},{"text":" ","type":"text"},{"text":"you need to make sure parameter shape won’t change when input changes, otherwise we","type":"text"},{"text":" ","type":"text"},{"text":"will fatal.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/init(_:name:)-4pup0","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/init(_:name:)-55gex"]},{"title":"Instance Methods","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/callAsFunction(_:inputs:_:streamContext:)-101bg","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/callAsFunction(_:inputs:_:streamContext:)-4i10p","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/callAsFunction(inputs:_:streamContext:)-4tnis","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/callAsFunction(inputs:_:streamContext:)-8pae9","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/compile(_:inputs:isEager:)-1lsvw","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/compile(_:inputs:isEager:)-8ge5z","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/compile(inputs:isEager:)-4kat6","doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/ModelBuilder\/compile(inputs:isEager:)-4yweq"]}],"metadata":{"navigatorTitle":[{"text":"ModelBuilder","kind":"identifier"}],"roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModelBuilder","kind":"identifier"}],"role":"symbol","modules":[{"name":"NNC"}],"externalID":"s:3NNC12ModelBuilderC","symbolKind":"class","title":"ModelBuilder"},"kind":"symbol","references":{"doc://org.liuliu.s4nnc/documentation/NNC/ModelBuilder/callAsF