{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention"},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inputs must have the same contiguous rank-4 NHWC "},{"code":"[N, T, H, D]","type":"codeVoice"},{"type":"text","text":" shape. Output"},{"type":"text","text":" "},{"type":"text","text":"retains that shape and separate heads; no layout conversion is implicit."},{"type":"text","text":" "},{"code":"approximationRange","type":"codeVoice"},{"type":"text","text":" is half-open and applies to both Q and KV. Only query"},{"type":"text","text":" "},{"type":"text","text":"groups and KV blocks wholly within the range may use summaries; protected"},{"type":"text","text":" "},{"type":"text","text":"and boundary-crossing interactions remain token-level. "},{"code":"localBlockRadius","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"must be at least one and keeps neighboring KV blocks exact."}]},{"type":"paragraph","inlineContent":[{"code":"scale","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"tau","type":"codeVoice"},{"text":" must be finite. Zero and negative scales are supported;","type":"text"},{"text":" ","type":"text"},{"code":"tau = 0","type":"codeVoice"},{"text":" does not request dense attention. Use ","type":"text"},{"code":"ScaledDotProductAttention","type":"codeVoice"},{"text":" ","type":"text"},{"text":"for dense attention.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU supports FP32 and general positive head, block, and query dimensions."},{"type":"text","text":" "},{"type":"text","text":"MPS requires FP16, D=128, block\/query sizes in {16, 32, 64}, and query size"},{"type":"text","text":" "},{"type":"text","text":"no larger than KV block size. MPS selects INT8 on neural-accelerator hardware"},{"type":"text","text":" "},{"type":"text","text":"and floating-point SIMD otherwise. "},{"type":"codeVoice","code":".disableMFANeuralAccelerators"},{"type":"text","text":" selects"},{"type":"text","text":" "},{"type":"text","text":"the latter; it is distinct from "},{"type":"codeVoice","code":".disableMFAAppleNeuralEngine"},{"type":"text","text":" (ANE)."}]},{"type":"paragraph","inlineContent":[{"text":"CUDA, backward, causal\/masked attention, GQA, unequal-length cross-attention,","type":"text"},{"text":" ","type":"text"},{"text":"and noncontiguous inputs are unsupported. There is no fallback to another op.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/nnc\/solattention"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"]]},"topicSections":[{"identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)"],"title":"Initializers"}],"abstract":[{"type":"text","text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V."}],"metadata":{"roleHeading":"Class","symbolKind":"class","role":"symbol","title":"SolAttention","externalID":"s:3NNC12SolAttentionC","navigatorTitle":[{"text":"SolAttention","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SolAttention","kind":"identifier"}],"modules":[{"name":"NNC"}]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model"],"title":"Inherits From","type":"inheritsFrom"},{"kind":"relationships","identifiers":["doc:\/\/org.liuliu.s4nnc\/documen