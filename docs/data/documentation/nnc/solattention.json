{"abstract":[{"text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V.","type":"text"}],"kind":"symbol","metadata":{"symbolKind":"class","title":"SolAttention","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}],"modules":[{"name":"NNC"}],"externalID":"s:3NNC12SolAttentionC","navigatorTitle":[{"kind":"identifier","text":"SolAttention"}],"roleHeading":"Class"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/nnc\/solattention"]}],"identifier":{"url":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inputs must have the same contiguous rank-4 NHWC "},{"type":"codeVoice","code":"[N, T, H, D]"},{"type":"text","text":" shape. Output"},{"type":"text","text":" "},{"type":"text","text":"retains that shape and separate heads; no layout conversion is implicit."},{"type":"text","text":" "},{"type":"codeVoice","code":"approximationRange"},{"type":"text","text":" is half-open and applies to both Q and KV. Only query"},{"type":"text","text":" "},{"type":"text","text":"groups and KV blocks wholly within the range may use summaries; protected"},{"type":"text","text":" "},{"type":"text","text":"and boundary-crossing interactions remain token-level. "},{"type":"codeVoice","code":"localBlockRadius"},{"type":"text","text":" "},{"type":"text","text":"must be at least one and keeps neighboring KV blocks exact."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"scale"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tau"},{"type":"text","text":" must be finite. Zero and negative scales are supported;"},{"type":"text","text":" "},{"type":"codeVoice","code":"tau = 0"},{"type":"text","text":" does not request dense attention. Use "},{"type":"codeVoice","code":"ScaledDotProductAttention"},{"type":"text","text":" "},{"type":"text","text":"for dense attention."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"CPU supports FP32 and general positive head, block, and query dimensions."},{"type":"text","text":" "},{"type":"text","text":"MPS requires FP16, D=128, block\/query sizes in {16, 32, 64}, and query size"},{"type":"text","text":" "},{"type":"text","text":"no larger than KV block size. MPS selects INT8 on neural-accelerator hardware"},{"type":"text","text":" "},{"type":"text","text":"and floating-point SIMD otherwise. "},{"type":"codeVoice","code":".disableMFANeuralAccelerators"},{"type":"text","text":" selects"},{"type":"text","text":" "},{"type":"text","text":"the latter; it is distinct from "},{"type":"codeVoice","code":".disableMFAAppleNeuralEngine"},{"type":"text","text":" (ANE)."}]},{"type":"paragraph","inlineContent":[{"text":"CUDA, backward, causal\/masked attention, GQA, unequal-length cross-attention,","type":"text"},{"text":" ","type":"text"},{"text":"and noncontiguous inputs are unsupported. There is no fallback to another op.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"]]},"sections":[],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)"]}],"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model"],"kind":"relationships","type":"inheritsFrom"},{"title":"Conforms To","i