"s:Si"},{"text":"?, ","kind":"text"},{"text":"localBlockRadius","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"name","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":")","kind":"text"}],"identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)","url":"\/documentation\/nnc\/solattention\/init(scale:tau:approximationrange:blocksize:queryblocksize:localblockradius:name:)","type":"topic","role":"symbol"},"doc://org.liuliu.s4nnc/documentation/NNC/SolAttention":{"title":"SolAttention","navigatorTitle":[{"text":"SolAttention","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SolAttention","kind":"identifier"}],"identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention","url":"\/documentation\/nnc\/solattention","type":"topic","role":"symbol"},"doc://org.liuliu.s4nnc/documentation/NNC/Model":{"navigatorTitle":[{"kind":"identifier","text":"Model"}],"url":"\/documentation\/nnc\/model","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Model"}],"identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model","type":"topic","title":"Model","abstract":[{"type":"text","text":"A model is a base class for stateful operations on a dynamic graph. It can be"},{"type":"text","text":" "},{"type":"text","text":"use to construct computations statically, thus, more efficient."}],"role":"symbol"}}}