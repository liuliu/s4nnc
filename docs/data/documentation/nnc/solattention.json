{"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)"]}],"identifier":{"url":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/nnc\/solattention"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"SolAttention","navigatorTitle":[{"kind":"identifier","text":"SolAttention"}],"externalID":"s:3NNC12SolAttentionC","modules":[{"name":"NNC"}],"symbolKind":"class","role":"symbol","roleHeading":"Class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}]},"hierarchy":{"paths":[["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"]]},"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model"],"kind":"relationships","type":"inheritsFrom"},{"title":"Conforms To","identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModel"],"kind":"relationships","type":"conformsTo"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Inputs must have the same contiguous rank-4 NHWC "},{"type":"codeVoice","code":"[N, T, H, D]"},{"type":"text","text":" shape. Output"},{"type":"text","text":" "},{"type":"text","text":"retains that shape and separate heads; no layout conversion is implicit."},{"type":"text","text":" "},{"type":"codeVoice","code":"approximationRange"},{"type":"text","text":" is half-open and applies to both Q and KV. Only query"},{"type":"text","text":" "},{"type":"text","text":"groups and KV blocks wholly within the range may use summaries; protected"},{"type":"text","text":" "},{"type":"text","text":"and boundary-crossing interactions remain token-level. "},{"type":"codeVoice","code":"localBlockRadius"},{"type":"text","text":" "},{"type":"text","text":"must be at least one and keeps neighboring KV blocks exact."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"scale"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tau"},{"type":"text","text":" must be finite. Zero and negative scales are supported;"},{"type":"text","text":" "},{"type":"codeVoice","code":"tau = 0"},{"type":"text","text":" does not request dense attention. Use "},{"type":"codeVoice","code":"ScaledDotProductAttention"},{"type":"text","text":" "},{"type":"text","text":"for dense attention."}],"type":"paragraph"},{"inlineContent":[{"text":"CPU supports FP32 and general positive head, block, and query dimensions.","type":"text"},{"text":" ","type":"text"},{"text":"MPS requires FP16, D=128, block\/query sizes in {16, 32, 64}, and query size","type":"text"},{"text":" ","type":"text"},{"text":"no larger than KV block size. MPS selects INT8 on neural-accelerator hardware","type":"text"},{"text":" ","type":"text"},{"text":"and floating-point SIMD otherwise. ","type":"text"},{"type":"codeVoice","code":".disableMFANeuralAccelerators"},{"text":" selects","type":"text"},{"text":" ","type":"text"},{"text":"the latter; it is distinct from ","type":"text"},{"type":"codeVoice","code":".disableMFAAppleNeuralEngine"},{"text":" (ANE).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"CUDA, backward, causal\/masked attention, GQA, unequal-length cross-attention,"},{"type":"text","text":" "},{"type":"text","text":"and noncontiguous inputs are unsupported. There is no fallback to another op."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://org.liuliu.s4nnc/documentation/NNC/Model":{"url":"\/documentation\/nnc\/model","role":"symbol","title":"Model","abstract":[{"text":"A model is a base class for stateful operations on a dynamic graph. It can be","type":"text"},{"text":" ","type":"text"},{"text":"use to construct computations statically, thus, more efficient.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Model"}],"identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Model"}],"type":"topic"},"doc://org.liuliu.s4nnc/documentation/NNC/SolAttention":{"navigatorTitle":[{"kind":"identifier","text":"SolAttention"}],"identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention","abstract":[{"text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V.","type":"text"}],"title":"SolAttention","url":"\/documentation\/nnc\/solattention","role":"symbol","kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"SolAttention","kind":"identifier"}]},"doc://org.liuliu.s4nnc/documentation/NNC/AnyModel":{"type":"topic","identifier":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModel","title":"AnyModel","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnyModel","kind":"identifier"}],"url":"\/documentation\/nnc\/anymodel","navigatorTitle":[{"text":"AnyModel","kind":"identifier"}]},"doc://org.liuliu.s4nnc/documentation/NNC/SolAttention/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)":{"url":"\/documentation\/nnc\/solattention\/init(scale:tau:approximationrange:blocksize:queryblocksize:localblockradius:name:)","type":"to