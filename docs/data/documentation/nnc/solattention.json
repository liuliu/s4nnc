{"topicSections":[{"identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention\/init(scale:tau:approximationRange:blockSize:queryBlockSize:localBlockRadius:name:)"],"title":"Initializers"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/SolAttention"},"kind":"symbol","abstract":[{"text":"Forward-only, parameter-free Sol approximate attention with exactly three inputs: Q, K, V.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/Model"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"},{"identifiers":["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC\/AnyModel"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SolAttention"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Inputs must have the same contiguous rank-4 NHWC ","type":"text"},{"type":"codeVoice","code":"[N, T, H, D]"},{"text":" shape. Output","type":"text"},{"text":" ","type":"text"},{"text":"retains that shape and separate heads; no layout conversion is implicit.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"approximationRange"},{"text":" is half-open and applies to both Q and KV. Only query","type":"text"},{"text":" ","type":"text"},{"text":"groups and KV blocks wholly within the range may use summaries; protected","type":"text"},{"text":" ","type":"text"},{"text":"and boundary-crossing interactions remain token-level. ","type":"text"},{"type":"codeVoice","code":"localBlockRadius"},{"text":" ","type":"text"},{"text":"must be at least one and keeps neighboring KV blocks exact.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"scale"},{"type":"text","text":" and "},{"type":"codeVoice","code":"tau"},{"type":"text","text":" must be finite. Zero and negative scales are supported;"},{"type":"text","text":" "},{"type":"codeVoice","code":"tau = 0"},{"type":"text","text":" does not request dense attention. Use "},{"type":"codeVoice","code":"ScaledDotProductAttention"},{"type":"text","text":" "},{"type":"text","text":"for dense attention."}],"type":"paragraph"},{"inlineContent":[{"text":"CPU supports FP32 and general positive head, block, and query dimensions.","type":"text"},{"text":" ","type":"text"},{"text":"MPS requires FP16, D=128, block\/query sizes in {16, 32, 64}, and query size","type":"text"},{"text":" ","type":"text"},{"text":"no larger than KV block size. MPS selects INT8 on neural-accelerator hardware","type":"text"},{"text":" ","type":"text"},{"text":"and floating-point SIMD otherwise. ","type":"text"},{"code":".disableMFANeuralAccelerators","type":"codeVoice"},{"text":" selects","type":"text"},{"text":" ","type":"text"},{"text":"the latter; it is distinct from ","type":"text"},{"code":".disableMFAAppleNeuralEngine","type":"codeVoice"},{"text":" (ANE).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"CUDA, backward, causal\/masked attention, GQA, unequal-length cross-attention,"},{"type":"text","text":" "},{"type":"text","text":"and noncontiguous inputs are unsupported. There is no fallback to another op."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/org.liuliu.s4nnc\/documentation\/NNC"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/nnc\/solattention"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"NNC"}],"externalID":"s:3NNC12SolAttentionC","title":"SolAttention","symbolKind":"class","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SolAttention"}],"roleHeading":"Class","fragments":[{"kin